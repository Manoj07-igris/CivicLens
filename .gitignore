# ==============================================================================
# CivicLens AI — Root .gitignore
# Strict exclusion of secrets, databases, personal data, and build artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets, Environment Variables & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*
*.secret
*.token
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. SQLite Databases & Persistent Storage
# ------------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Ignore top-level files in backend/data (e.g., civiclens.db, LEGACY_IMPORTED.txt)
backend/data/*
!backend/data/.gitkeep
# Re-include subdirectories so Git traverses them
!backend/data/*/
# Ignore all files inside subdirectories (e.g., uploads, indexes, backups)
backend/data/*/*
# Whitelist .gitkeep in subdirectories
!backend/data/*/.gitkeep
# Re-include 2nd level subdirectories (e.g., uploads/doc_id/)
!backend/data/*/*/
# Ignore files inside 2nd level subdirectories
backend/data/*/*/*
!backend/data/*/*/.gitkeep
# Ignore files inside 3rd level subdirectories
backend/data/*/*/*/*
!backend/data/*/*/*/.gitkeep

legacy/
**/legacy/

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments, Bytecode & Cache
# ------------------------------------------------------------------------------
backend/.venv/
.venv/
venv/
ENV/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Dependencies / Builds
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Playwright & Test Output
# ------------------------------------------------------------------------------
playwright-report/
**/playwright-report/
test-results/
**/test-results/
blob-report/
**/blob-report/
tools/e2e/**/node_modules/

# ------------------------------------------------------------------------------
# 6. Logs & Process Identifiers
# ------------------------------------------------------------------------------
logs/*
!logs/.gitkeep
*.log
**/*.log
*.pid
**/*.pid

# ------------------------------------------------------------------------------
# 7. Demo Assets & User Uploads
# ------------------------------------------------------------------------------
demo_assets/*
!demo_assets/README.md
!demo_assets/demo_config.example.json
!demo_assets/.gitkeep
backend/evals/user_assets/*
!backend/evals/user_assets/.gitkeep
!backend/evals/user_assets/README.md

# ------------------------------------------------------------------------------
# 8. IDE, OS & Tooling Metadata
# ------------------------------------------------------------------------------
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
Thumbs.db
[Dd]esktop.ini
.DS_Store
**/.DS_Store

# ------------------------------------------------------------------------------
# 9. AI Agent / Local Scratch & Brain Directories
# ------------------------------------------------------------------------------
.gemini/
**/.gemini/
.antigravity/
**/.antigravity/
brain/
**/brain/
scratch/
**/scratch/
