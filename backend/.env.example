# CivicLens Backend Environment Configuration
# IMPORTANT: This is a template. Never commit your actual '.env' file or expose API keys in version control.
# Copy this file to '.env' inside the backend/ directory and configure your local settings.

# Google Gemini API key from Google AI Studio (Backend only - never exposed to frontend or Git)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini client settings
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# Application runtime environment (development, staging, production)
APP_ENV=development

# Allowed CORS origins (comma-separated for multiple origins, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Maximum file upload size in megabytes (for document processing)
MAX_UPLOAD_MB=20

# PDF & Document Processing Limits
MAX_PDF_PAGES=200
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# Local Tesseract OCR Configuration (Optional fallback for scanned PDFs)
OCR_ENABLED=true
OCR_MAX_PAGES=30
OCR_DPI=200
OCR_LANGUAGES=tam+eng
# Optional Windows Tesseract binary path override (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# RAG & Embeddings Configuration (Phase 8: Multilingual Policy Intelligence)
# Default model: intfloat/multilingual-e5-small (multilingual 384-dim, 94+ languages including Tamil and English)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=16
# Optional local model cache directory (defaults to backend/data/models)
EMBEDDING_CACHE_DIR=
# Retrieval parameters
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.65
RAG_MAX_CONTEXT_CHARS=6000
RAG_RATE_LIMIT_PER_MINUTE=10

# Central AI Agent Configuration (Phase 9: Function Calling & Tool Orchestration)
AGENT_MAX_STEPS=4
AGENT_MAX_TOOL_CALLS_PER_RUN=6
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_RATE_LIMIT_PER_MINUTE=10

# Policy Change Detection Configuration (Phase 10: Module 2 Policy Intelligence)
COMPARE_MAX_PAGES_PER_DOC=100
COMPARE_MAX_CANDIDATES=60
COMPARE_BATCH_SIZE=12
COMPARE_MAX_GEMINI_CALLS=4
COMPARE_SIMILARITY_MATCH_THRESHOLD=0.55
COMPARE_RATE_LIMIT_PER_MINUTE=3

# Fact Verification & Official Source Library Configuration (Phase 11: Module 3 Fact Verification)
VERIFY_MAX_GEMINI_CALLS=2
VERIFY_MAX_CLAIMS=5
VERIFY_CLAIM_MAX_CHARS=1000
VERIFY_TOP_K_PER_SOURCE=3
VERIFY_TOP_K_TOTAL=8
VERIFY_MAX_SOURCES_SEARCHED=30
VERIFY_RATE_LIMIT_PER_MINUTE=5
SOURCE_STALE_AFTER_DAYS=365
ALLOW_SOURCE_MANAGEMENT=true

# Public Service Assistant & Portal Registry Configuration (Phase 12: Module 4 Public Service Intelligence)
SERVICE_MAX_GEMINI_CALLS=1
SERVICE_QUERY_MAX_CHARS=600
SERVICE_TOP_K_TOTAL=10
SERVICE_RATE_LIMIT_PER_MINUTE=5
SERVICE_MAX_CHECKLIST_ITEMS=30
FORM_FIELDS_MAX=40
ALLOW_PORTAL_MANAGEMENT=true

# Civic Grievance Assistant Configuration (Phase 13: Module 5 Grievance Intelligence)
GRIEVANCE_MIN_DESCRIPTION_CHARS=10
GRIEVANCE_MAX_DESCRIPTION_CHARS=2000
GRIEVANCE_LOCATION_MAX_CHARS=300
GRIEVANCE_MAX_IMAGE_MB=5
GRIEVANCE_IMAGE_MAX_DIMENSION=1600
GRIEVANCE_MAX_PIXELS=25000000
GRIEVANCE_MAX_GEMINI_CALLS=1
GRIEVANCE_RATE_LIMIT_PER_MINUTE=6
GRIEVANCE_RECORDS_MAX=200
EMERGENCY_CONTACT_TEXT="112 (India)"
DEMO_ID_PREFIX=DEMO

# Playwright Browser Automation Configuration (Phase 14: Controlled Demo Workflow)
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_SLOW_MO_MS=0
BROWSER_SESSION_TTL_SECONDS=600
BROWSER_IDLE_CLOSE_SECONDS=120
BROWSER_MAX_ACTIONS_PER_SESSION=60
BROWSER_ACTION_TIMEOUT_MS=8000
BROWSER_NAVIGATION_TIMEOUT_MS=10000
BROWSER_VIEWPORT_WIDTH=1024
BROWSER_VIEWPORT_HEIGHT=720
BROWSER_SCREENSHOT_MAX_WIDTH=900
BROWSER_SCREENSHOT_QUALITY=70
BROWSER_MAX_SCREENSHOTS_PER_SESSION=40
BROWSER_MAX_CONCURRENT_SESSIONS=1
BROWSER_RECORDS_MAX=50
BROWSER_RATE_LIMIT_PER_MINUTE=20
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Database, History & Integration Configuration (Phase 15: Unified SQLite Persistence)
DATABASE_PATH=backend/data/civiclens.db
DATABASE_BUSY_TIMEOUT_MS=5000
DATABASE_BACKUP_DIR=backend/data/backups
DATABASE_BACKUPS_KEEP=5
ACTIVITY_RETENTION_DAYS=90
LEGACY_IMPORT_ENABLED=true
MAINTENANCE_ON_STARTUP=true
DELETE_ALL_CONFIRM_PHRASE="DELETE MY DATA"
ACTIVITY_PAGE_SIZE_MAX=50

# Security Hardening, Quota Guard & Serving Options (Phase 16)
GEMINI_GLOBAL_RPM_CAP=30
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ENABLE_API_DOCS=false
SERVE_FRONTEND=false

# Authentication & Account System (v1.1.0-auth)
AUTH_SECRET_KEY=
ADMIN_EMAILS=
AUTH_ALLOW_REGISTRATION=true


# ==============================================================================
# LITE_MODE PRESET (For Low-Spec Machines: Intel i3, 4-8 GB RAM, CPU-only)
# ==============================================================================
# To activate Lite Mode, uncomment the following lightweight overrides:
# MAX_UPLOAD_MB=10
# MAX_PDF_PAGES=50
# OCR_ENABLED=false
# OCR_MAX_PAGES=10
# EMBEDDING_BATCH_SIZE=8
# RETRIEVAL_TOP_K=4
# AGENT_MAX_STEPS=3
# AGENT_MAX_TOOL_CALLS_PER_RUN=4
# COMPARE_MAX_PAGES_PER_DOC=30
# COMPARE_MAX_CANDIDATES=20
# BROWSER_ENABLED=false
# GEMINI_GLOBAL_RPM_CAP=15




